{
  "uid": "freezermon-operator",
  "title": "FreezerMon \u2014 Operator",
  "tags": [
    "freezermon",
    "operator"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 0,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 2,
  "templating": {
    "list": [
      {
        "name": "device",
        "label": "Unit",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb"
        },
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"telemetry\", tag: \"device\")",
        "current": {
          "text": "cooler-01",
          "value": "cooler-01"
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Status",
      "description": "Cabinet temperature has been above the limit for several readings in a row. Check the cooler.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "TOO WARM",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "refId": "A",
          "query": "from(bucket: \"telemetry\")\n |> range(start: -30d)\n |> filter(fn: (r) => r._measurement == \"telemetry\" and r.device =~ /^${device:regex}$/ and r._field == \"alarm\")\n |> last()\n |> keep(columns: [\"_value\"])"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Cabinet temperature",
      "description": "Inside the cabinet. Limit 8 \u00b0C.",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 6
              },
              {
                "color": "red",
                "value": 8
              }
            ]
          },
          "unit": "celsius"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "decimals": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "refId": "A",
          "query": "from(bucket: \"telemetry\")\n |> range(start: -30d)\n |> filter(fn: (r) => r._measurement == \"telemetry\" and r.device =~ /^${device:regex}$/ and r._field == \"t_cab\")\n |> last()\n |> keep(columns: [\"_value\"])"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Door",
      "description": "Door reed switch.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 6
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "CLOSED",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "OPEN",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "refId": "A",
          "query": "from(bucket: \"telemetry\")\n |> range(start: -30d)\n |> filter(fn: (r) => r._measurement == \"telemetry\" and r.device =~ /^${device:regex}$/ and r._field == \"door\")\n |> last()\n |> keep(columns: [\"_value\"])"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Connection",
      "description": "ONLINE = a report in the last 15 minutes. LATE = 15\u201360 min. OFFLINE = over an hour \u2014 the unit may be out of coverage, out of battery, or switched off.",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 6
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 0,
                "to": 900,
                "result": {
                  "text": "ONLINE",
                  "color": "green",
                  "index": 0
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 900,
                "to": 3600,
                "result": {
                  "text": "LATE",
                  "color": "orange",
                  "index": 1
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 3600,
                "to": 1000000000000.0,
                "result": {
                  "text": "OFFLINE",
                  "color": "red",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "refId": "A",
          "query": "from(bucket: \"telemetry\")\n |> range(start: -30d)\n |> filter(fn: (r) => r._measurement == \"telemetry\" and r.device =~ /^${device:regex}$/ and r._field == \"fw\")\n |> last()\n |> map(fn: (r) => ({r with _value: (int(v: now()) - int(v: r._time)) / 1000000000}))\n |> keep(columns: [\"_value\"])"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Last contact",
      "description": "When the unit last reported.",
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 6
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "dateTimeFromNow"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "refId": "A",
          "query": "from(bucket: \"telemetry\")\n |> range(start: -30d)\n |> filter(fn: (r) => r._measurement == \"telemetry\" and r.device =~ /^${device:regex}$/ and r._field == \"fw\")\n |> last()\n |> map(fn: (r) => ({r with _value: r._time}))\n |> keep(columns: [\"_value\"])"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Power",
      "description": "MAINS = external supply connected. ON BATTERY = running on the internal cell.",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "ON BATTERY",
                  "color": "orange",
                  "index": 0
                },
                "1": {
                  "text": "MAINS",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "refId": "A",
          "query": "from(bucket: \"telemetry\")\n |> range(start: -30d)\n |> filter(fn: (r) => r._measurement == \"telemetry\" and r.device =~ /^${device:regex}$/ and r._field == \"ext_power\")\n |> last()\n |> keep(columns: [\"_value\"])"
        }
      ]
    },
    {
      "id": 7,
      "type": "gauge",
      "title": "Battery",
      "description": "Estimated charge of the internal cell. Below 20 % \u2014 recharge or connect power.",
      "gridPos": {
        "x": 8,
        "y": 6,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 20
              },
              {
                "color": "green",
                "value": 40
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "refId": "A",
          "query": "from(bucket: \"telemetry\")\n |> range(start: -30d)\n |> filter(fn: (r) => r._measurement == \"telemetry\" and r.device =~ /^${device:regex}$/ and r._field == \"vbat_mv\")\n |> last()\n |> map(fn: (r) => ({r with _value: if r._value < 3400 then 0.0 else if r._value > 4200 then 100.0 else (float(v: r._value) - 3400.0) / 8.0}))\n |> keep(columns: [\"_value\"])"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Movement",
      "description": "MOVING = the unit has travelled more than 150 m from where it was parked.",
      "gridPos": {
        "x": 16,
        "y": 6,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "PARKED",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "MOVING",
                  "color": "orange",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "refId": "A",
          "query": "from(bucket: \"telemetry\")\n |> range(start: -30d)\n |> filter(fn: (r) => r._measurement == \"telemetry\" and r.device =~ /^${device:regex}$/ and r._field == \"moving\")\n |> last()\n |> keep(columns: [\"_value\"])"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Cabinet temperature \u2014 last 24 hours",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 14,
        "h": 10
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "#3b82f6"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 8
              }
            ]
          },
          "displayName": "Cabinet"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "hidden"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "refId": "A",
          "query": "from(bucket: \"telemetry\")\n |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n |> filter(fn: (r) => r._measurement == \"telemetry\" and r.device =~ /^${device:regex}$/ and r._field == \"t_cab\")\n |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n |> keep(columns: [\"_time\",\"_value\"])"
        }
      ]
    },
    {
      "id": 10,
      "type": "geomap",
      "title": "Where it is",
      "description": "Red = current position. Blue = where it has been in the selected time range.",
      "gridPos": {
        "x": 14,
        "y": 11,
        "w": 10,
        "h": 10
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "options": {
        "view": {
          "id": "fit",
          "lat": 55.99,
          "lon": 9.958,
          "zoom": 12
        },
        "basemap": {
          "type": "osm-standard",
          "name": "OSM"
        },
        "tooltip": {
          "mode": "details"
        },
        "layers": [
          {
            "type": "route",
            "name": "Track",
            "filterData": {
              "id": "byRefId",
              "options": "Track"
            },
            "location": {
              "mode": "coords",
              "latitude": "lat",
              "longitude": "lon"
            },
            "config": {
              "style": {
                "color": {
                  "fixed": "#3b82f6"
                },
                "lineWidth": 2,
                "opacity": 0.8,
                "size": {
                  "fixed": 4
                }
              },
              "arrow": 1
            },
            "tooltip": true
          },
          {
            "type": "markers",
            "name": "Now",
            "filterData": {
              "id": "byRefId",
              "options": "Latest"
            },
            "location": {
              "mode": "coords",
              "latitude": "lat",
              "longitude": "lon"
            },
            "config": {
              "style": {
                "size": {
                  "fixed": 10
                },
                "color": {
                  "fixed": "red"
                }
              }
            },
            "tooltip": true
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "refId": "Latest",
          "query": "from(bucket: \"telemetry\")\n |> range(start: -30d)\n |> filter(fn: (r) => r._measurement == \"telemetry\" and r.device =~ /^${device:regex}$/)\n |> filter(fn: (r) => r._field == \"lat\" or r._field == \"lon\")\n |> last()\n |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")"
        },
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "refId": "Track",
          "query": "from(bucket: \"telemetry\")\n |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n |> filter(fn: (r) => r._measurement == \"telemetry\" and r.device =~ /^${device:regex}$/)\n |> filter(fn: (r) => r._field == \"lat\" or r._field == \"lon\")\n |> drop(columns: [\"device\", \"topic\"])\n |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n |> filter(fn: (r) => exists r.lat and exists r.lon)\n |> sort(columns: [\"_time\"])"
        }
      ]
    },
    {
      "id": 11,
      "type": "table",
      "title": "Events \u2014 last 24 hours",
      "description": "Alarms and notable events the unit sent.",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb"
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "When",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "_time"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "When"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "kind"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Event"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "temp_breach": {
                        "text": "Cabinet too warm",
                        "color": "red",
                        "index": 0
                      },
                      "door_open": {
                        "text": "Door opened",
                        "color": "orange",
                        "index": 1
                      },
                      "moving": {
                        "text": "Unit started moving",
                        "color": "orange",
                        "index": 2
                      },
                      "batt_low": {
                        "text": "Battery low",
                        "color": "red",
                        "index": 3
                      },
                      "cold_charge": {
                        "text": "Charging while too cold",
                        "color": "orange",
                        "index": 4
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "t_cab"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Cabinet \u00b0C"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "vbat_mv"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Battery mV"
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb"
          },
          "refId": "A",
          "query": "from(bucket: \"telemetry\")\n |> range(start: -24h)\n |> filter(fn: (r) => r._measurement == \"alert\" and r.device =~ /^${device:regex}$/)\n |> drop(columns: [\"device\", \"topic\"])\n |> pivot(rowKey: [\"_time\", \"kind\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n |> group()\n |> sort(columns: [\"_time\"], desc: true)\n |> limit(n: 50)\n |> keep(columns: [\"_time\", \"kind\", \"t_cab\", \"vbat_mv\"])"
        }
      ]
    }
  ]
}
