# freezerMon platform secrets — copy to .env and fill in. Never commit .env.
# Generate strong values, e.g.:  openssl rand -hex 24

# InfluxDB
INFLUX_PASSWORD=
INFLUX_TOKEN=            # admin token, used ONLY by the one-time InfluxDB setup and by you
TELEGRAF_INFLUX_TOKEN=   # write-only token for the telemetry bucket (create after setup, see README)
GRAFANA_INFLUX_TOKEN=    # read-only token for the telemetry bucket
INFLUX_ORG=freezermon
INFLUX_BUCKET=telemetry

# MQTT identities (all created via mosquitto_passwd, see README §Platform). Each is
# confined to its own topics by mosquitto/config/acl — do not reuse one for another role.
MQTT_USER=freezer                # devices (compiled into config.h): telemetry/alert write, cmd read
MQTT_PASSWORD=
TELEGRAF_MQTT_USER=telegraf      # ingest: read-only
TELEGRAF_MQTT_PASSWORD=
PUBLISHER_MQTT_USER=publisher    # PublishFirmware.ts: cmd write only
PUBLISHER_MQTT_PASSWORD=

# OTA download path secret: the firmware pieces are served at /fw/<OTA_PATH_TOKEN>/
# (docker-compose.traefik.yml). Treat as a bearer secret — it is also baked into the
# device's OTA_MANIFEST_URL, so rotating it means a firmware release.
OTA_PATH_TOKEN=

# Grafana logins: admin (full control) + operator (read-only viewer)
GRAFANA_ADMIN_PASSWORD=
GRAFANA_OPERATOR_PASSWORD=
# GRAFANA_PORT=3000   # host port for the Grafana UI (default 3000)

# Not used by the stack — recorded here so the device's WiFi debug-console
# password (DEBUG_AP_PASSWORD in firmware config.h) is findable later.
DEVICE_DEBUG_AP_PASSWORD=
